# ============================================================================
# AGENTIC FASTAPI TEMPLATE - CONFIGURATION EXAMPLE v2.1
# ============================================================================
# WARNING: EXAMPLE CONFIGURATION - DO NOT USE IN PRODUCTION AS-IS
#
# SECURITY CRITICAL: Before deploying to production, you MUST:
#   1. Copy this file to src/.env
#   2. Generate a new SECRET_KEY using: openssl rand -hex 32
#   3. Change all passwords (POSTGRES_PASSWORD, ADMIN_PASSWORD, etc.)
#   4. Update all sensitive configuration values
#
# Using these example values in production is a SECURITY RISK.
# ============================================================================


# =============================================================================
# CORE APPLICATION
# =============================================================================

APP_NAME="Agentic FastAPI Template"
APP_DESCRIPTION="Enterprise-ready Agentic AI template built on top of FastAPI and LangGraph."
APP_VERSION="2.1.0"
CONTACT_NAME="LegendStack"
CONTACT_EMAIL="manohar@tallapaneni.com"
LICENSE_NAME="MIT"
ENVIRONMENT="local"  # local, staging, production


# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"


# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Generate with: openssl rand -hex 32
SECRET_KEY="change_this_to_a_random_64_char_hex_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth provider: "local" or "entra" (Azure AD)
AUTH_PROVIDER="local"

# Azure Entra ID (required for azure integrations with OAuth2)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""


# =============================================================================
# ADMIN USER
# =============================================================================

ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisPassword!"


# =============================================================================
# REDIS (Cache, Queue, Rate Limiting)
# =============================================================================

REDIS_CACHE_HOST="redis"
REDIS_CACHE_PORT=6379

REDIS_QUEUE_HOST="redis"
REDIS_QUEUE_PORT=6379

REDIS_RATE_LIMIT_HOST="redis"
REDIS_RATE_LIMIT_PORT=6379


# =============================================================================
# AZURE OPENAI
# =============================================================================

# Authentication mode: api_key | oauth2 | managed_identity
AZURE_OPENAI_AUTH_MODE="api_key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-ada-002"

# If AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=""

# If AUTH_MODE=oauth2 (uses AZURE_TENANT_ID above)
# AZURE_OPENAI_CLIENT_ID=""
# AZURE_OPENAI_CLIENT_SECRET=""


# =============================================================================
# AZURE AI SEARCH
# =============================================================================

# Authentication mode: api_key | oauth2 | managed_identity
AZURE_SEARCH_AUTH_MODE="api_key"
AZURE_SEARCH_ENDPOINT="https://your-search.search.windows.net"
AZURE_SEARCH_INDEX_NAME="agent-index"

# If AUTH_MODE=api_key
AZURE_SEARCH_KEY=""

# If AUTH_MODE=oauth2 (uses AZURE_TENANT_ID above)
# AZURE_SEARCH_CLIENT_ID=""
# AZURE_SEARCH_CLIENT_SECRET=""


# =============================================================================
# VECTOR STORE BACKEND
# =============================================================================

# Options: "pgvector" (default) or "azure_search"
RAG_BACKEND="pgvector"


# =============================================================================
# JIRA
# =============================================================================

# Authentication mode: pat | basic | oauth2
JIRA_AUTH_MODE="pat"
JIRA_URL="https://your-company.atlassian.net"
JIRA_PROJECTS=["PROJ1", "PROJ2"]

# If AUTH_MODE=pat OR basic
JIRA_USERNAME="your.email@company.com"
JIRA_API_TOKEN=""

# If AUTH_MODE=oauth2 (Jira Cloud only)
# JIRA_CLIENT_ID=""
# JIRA_CLIENT_SECRET=""
# JIRA_REFRESH_TOKEN=""    # Obtained after initial OAuth2 authorization
# JIRA_CLOUD_ID=""         # Your Atlassian Cloud ID


# =============================================================================
# CONFLUENCE
# =============================================================================

# Authentication mode: pat | basic | oauth2
CONFLUENCE_AUTH_MODE="pat"
CONFLUENCE_URL="https://your-company.atlassian.net/wiki"
CONFLUENCE_SPACES=["PRODUCT", "ENGINEERING"]

# If AUTH_MODE=pat OR basic
CONFLUENCE_USERNAME="your.email@company.com"
CONFLUENCE_API_TOKEN=""

# If AUTH_MODE=oauth2 (Confluence Cloud only)
# CONFLUENCE_CLIENT_ID=""
# CONFLUENCE_CLIENT_SECRET=""
# CONFLUENCE_REFRESH_TOKEN=""
# CONFLUENCE_CLOUD_ID=""


# =============================================================================
# SHAREPOINT
# =============================================================================

# Authentication mode: oauth2 | managed_identity
SHAREPOINT_AUTH_MODE="oauth2"
SHAREPOINT_SITE_URL="https://contoso.sharepoint.com/sites/docs"
SHAREPOINT_CLIENT_ID=""
SHAREPOINT_CLIENT_SECRET=""


# =============================================================================
# MICROSOFT GRAPH (OneDrive, Teams, Outlook)
# =============================================================================

# Authentication mode: oauth2 | managed_identity
GRAPH_AUTH_MODE="oauth2"
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""


# =============================================================================
# AZURE BLOB STORAGE
# =============================================================================

# Authentication mode: api_key | oauth2 | managed_identity
AZURE_BLOB_AUTH_MODE="api_key"
AZURE_BLOB_ACCOUNT_URL="https://youraccount.blob.core.windows.net"

# If AUTH_MODE=api_key (connection string contains key)
# AZURE_BLOB_CONNECTION_STRING=""


# =============================================================================
# COHERE RERANKING
# =============================================================================

COHERE_API_KEY=""
COHERE_RERANK_MODEL="rerank-english-v2.0"


# =============================================================================
# OPENTELEMETRY / DATADOG OBSERVABILITY
# =============================================================================

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
DD_SERVICE="agentic-fastapi-template"
DD_ENV="local"
DD_VERSION="2.1.0"


# =============================================================================
# PRODUCTION STABILITY (V4.0)
# =============================================================================

# Semantic Caching (Redis-backed)
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.9
SEMANTIC_CACHE_TTL=86400  # 24 hours in seconds

# Self-Correction (Reflector Pattern)
ENABLE_REFLECTOR=true
REFLECTOR_THRESHOLD=0.8

# High-Fidelity Parsing (Unstructured.io)
PREFER_UNSTRUCTURED=true


# =============================================================================
# RATE LIMITING
# =============================================================================

# Default tier for new tenants: free, standard, premium, enterprise
DEFAULT_RATE_LIMIT_TIER="standard"


# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]


# =============================================================================
# CLIENT CACHE
# =============================================================================

CLIENT_CACHE_MAX_AGE=60


# =============================================================================
# TIER SYSTEM
# =============================================================================

TIER_NAME="free"


# =============================================================================
# TEST USER (for development/testing only)
# =============================================================================

TEST_NAME="Tester User"
TEST_EMAIL="test@tester.com"
TEST_USERNAME="testeruser"
TEST_PASSWORD="Str1ngT3st!"
